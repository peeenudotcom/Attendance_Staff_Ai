{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15,
      "includeFiles": "{lib/face-selftest.jpg,node_modules/@vladmandic/face-api/model/{ssd_mobilenetv1,face_landmark_68,face_recognition}_model*,node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/erase-accounts",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "30 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/android",
      "destination": "https://expo.dev/artifacts/eas/bNFtAa3Hr2CfpECFDBvKSET0KDFOSGleunjDtFhfO9I.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/payslip",
      "destination": "/api/payslips/view"
    }
  ]
}
